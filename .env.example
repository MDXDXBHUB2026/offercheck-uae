# Server environment variables for Offer Check. Names only: never commit values.
# Set them in the Vercel project settings (Production and Preview). Locally, with none of the
# rate-limit variables set, the limits run in memory with a fixed test salt.

# Google Cloud Translation (Basic, v2). Without it, translation is unavailable.
GOOGLE_TRANSLATE_API_KEY=

# Rate limits (src/lib/rateLimit.ts): the Upstash Redis store, read and write. Only these two store
# variables are used; KV_REST_API_READ_ONLY_TOKEN, KV_URL and REDIS_URL are not.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret salt for hashing the client address (HMAC-SHA-256). Required with the store; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OFFERCHECK_RATE_SALT=

# Most characters sent to Google per UTC day, for the whole app. 15000 when unset.
OFFERCHECK_DAILY_CHAR_CAP=
