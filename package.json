{
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:no-bypass": "node scripts/check-no-bypass.mjs",
    "check": "npm test && npm run typecheck && npm run lint && npm run build && npm run check:no-bypass"
  },
  "name": "offercheck",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
